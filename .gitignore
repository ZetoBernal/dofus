# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (front/)
front/.next/
front/out/
front/next-env.d.ts

# nest build output (back/)
back/dist/

# prisma generated client (back/)
back/src/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# imágenes subidas desde /admin — contenido en runtime, no del pipeline de
# scraping. En producción necesita un volumen persistente montado acá.
back/uploads/*
!back/uploads/.gitkeep
